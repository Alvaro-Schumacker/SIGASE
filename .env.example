# Copie este arquivo para .env e cole a connection string do Supabase.
# Dashboard do projeto > Connect > Session pooler (recomendado para IPv4).
# Não compartilhe nem envie este valor: ele contém a senha do banco.
SUPABASE_DATABASE_URL=postgresql://postgres.PROJECT_REF:SUA_SENHA@aws-0-REGION.pooler.supabase.com:5432/postgres

# Porta local da aplicação (opcional)
SIGASE_PORT=8000
